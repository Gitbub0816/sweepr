<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Clean with Sweepr</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.getsweepr.cleaner</string>
    <key>CFBundleName</key>
    <string>Clean with Sweepr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- App targets the iOS 26 SDK (Xcode 26+). -->
    <key>MinimumOSVersion</key>
    <string>26.0</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- Cleaners get turn-by-turn routing and share position for live tracking. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Clean with Sweepr uses your location for job routing and to share live arrival with the customer.</string>
    <key>NSCameraUsageDescription</key>
    <string>Clean with Sweepr uses the camera to capture before/after photos required for check-in and checkout.</string>
    <!-- Biometric re-auth gate before revealing/unlocking Smart Entry access. -->
    <key>NSFaceIDUsageDescription</key>
    <string>Clean with Sweepr uses Face ID to confirm it's you before revealing or unlocking a customer's Smart Entry access.</string>
</dict>
</plist>
