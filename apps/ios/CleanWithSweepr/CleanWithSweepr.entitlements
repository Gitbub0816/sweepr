<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright © 2026–Present ClearKey Solutions, LLC.
  All Rights Reserved. Proprietary and Confidential.

  Capabilities for the Clean with Sweepr cleaner app (com.getsweepr.cleaner):
    - aps-environment: Apple Push Notifications (job assignments, schedule
      changes). Committed as "development"; distribution promotes to
      "production" automatically at export — do not hard-code "production".
    - associated-domains: universal links from clean.getsweepr.com (job and
      day-of-service deep links open the app instead of Safari).
  No keychain-access-groups: no share/extension target and no cross-app keychain
  sharing, so none is declared.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>development</string>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:clean.getsweepr.com</string>
    </array>
</dict>
</plist>
