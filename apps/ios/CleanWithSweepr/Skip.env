# SKIP app configuration for the Clean with Sweepr cleaner app.
PRODUCT_NAME = "Clean with Sweepr"
BUNDLE_ID = "com.getsweepr.cleaner"
ANDROID_PACKAGE_NAME = "com.getsweepr.cleaner"
VERSION = "0.1.0"
BUILD = "1"
# Targets the iOS 26 SDK (Xcode 26+).
IPHONEOS_DEPLOYMENT_TARGET = 26.0
# Clerk publishable key (pk_… only). Same primary application as customers —
# clerk.getsweepr.com; one account can be both customer and cleaner.
CLERK_PUBLISHABLE_KEY = "pk_live_REPLACE_ME"
API_BASE_URL = "https://api.getsweepr.com"
