#
# SKIP configuration for the shared SweeprKit package. The product apps (Sweepr,
# CleanWithSweepr) carry the bundle/applicationId; SweeprKit only needs the
# deployment floor so its transpiled Gradle module agrees with the apps.
#
# iOS 26 SDK (Xcode 26+) — mirrors Package.swift .iOS(.v26).
IPHONEOS_DEPLOYMENT_TARGET = 26.0
