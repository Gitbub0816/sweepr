<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Sweepr</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.getsweepr.customer</string>
    <key>CFBundleName</key>
    <string>Sweepr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- iOS 26 SDK floor — matches Package.swift .iOS(.v26) + Skip.env
         IPHONEOS_DEPLOYMENT_TARGET. -->
    <key>MinimumOSVersion</key>
    <string>26.0</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Custom scheme the hosted Stripe pay page (app.getsweepr.com/pay) uses
         for its "Open the Sweepr app" bounce-back after payment. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.getsweepr.customer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>sweepr</string>
            </array>
        </dict>
    </array>

    <!-- ===== Privacy usage strings (App Review 5.1.1) ===== -->

    <!-- Foreground-only: LiveTracking shows the cleaner's approach on a MapKit
         map and confirms the saved service address. The customer app never
         tracks location in the background (no "location" background mode). -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Sweepr uses your location while the app is open to show your cleaner's live arrival on the map and to confirm your service address.</string>

    <!-- Scope-request and booking photos captured with the camera. -->
    <key>NSCameraUsageDescription</key>
    <string>Sweepr uses the camera so you can photograph the areas you want cleaned and attach them to a booking or scope request.</string>

    <!-- Attaching existing photos to a booking or scope request. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Sweepr needs access to your photo library so you can attach existing photos to a booking or scope request.</string>

    <!-- ===== Background execution ===== -->
    <!-- Push only. NO background "location": the customer app tracks the
         cleaner's arrival only while open. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
