<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Sweepr</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.getsweepr.customer</string>
    <key>CFBundleName</key>
    <string>Sweepr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- Live cleaner tracking needs the map + when-in-use location. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Sweepr uses your location to show your cleaner's live arrival and confirm your service address.</string>
    <key>NSCameraUsageDescription</key>
    <string>Sweepr uses the camera to add photos to your booking and scope requests.</string>
</dict>
</plist>
