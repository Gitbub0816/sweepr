#
# SKIP app configuration consumed by `skip export` / the Android module build.
# These values feed the generated Gradle project (AndroidManifest, applicationId).
PRODUCT_NAME = "Sweepr"
BUNDLE_ID = "com.getsweepr.customer"
ANDROID_PACKAGE_NAME = "com.getsweepr.customer"
VERSION = "0.1.0"
BUILD = "1"
# Clerk publishable key (pk_… only — never a secret key). Set the real live key
# in CI. clerk.getsweepr.com primary application.
CLERK_PUBLISHABLE_KEY = "pk_live_REPLACE_ME"
API_BASE_URL = "https://api.getsweepr.com"
# Deployment target: iOS 26 SDK (Xcode 26+). Mirrors Package.swift .iOS(.v26)
# and Darwin/Info.plist MinimumOSVersion so the SwiftPM, Xcode, and generated
# Android/Gradle builds all agree on the floor.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
